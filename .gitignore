# ── OS / editor noise ─────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
.idea/
*.iml
.vscode/
.fleet/

# ── secrets — NEVER commit ────────────────────────
server/web/.env
.env
.env.local
.env.*
!.env.example
**/key.properties
*.jks
*.keystore
*.jks.tmp
**/service-account.json

# ── build / generated output ──────────────────────
**/build/
**/.dart_tool/
**/.gradle/
**/.cxx/
**/node_modules/
**/.pub-cache/
**/.packages
**/*.log
assets/_generated/
apps/mobile/assets/_generated/

# ── binary artifacts (stale APKs big enough to wreck the repo) ──
*.apk
*.aab
*.ipa

# ── coverage / test temp ──────────────────────────
**/coverage/
.continue/agents/new-config.yaml
.continue/prompts/new-prompt.md
.continue/rules/new-rule.md

# ── documentation ─────────────────────────────────
# NOTE: Markdown documentation is deliberately TRACKED, never ignored.
# docs/API.md is the only written record of the /api/v1 contract; AGENT.md,
# modular.md and client.md are the architecture baseline. Do NOT add broad
# rules such as `*.md` or `docs/` here — they will delete that corpus.


# Lockfiles for pure-Dart shared packages are resolved on demand;
# the apps that depend on them own the committed resolution.
packages/*/pubspec.lock
